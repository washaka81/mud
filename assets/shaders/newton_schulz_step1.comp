#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer XBuffer { float x[]; };
layout(set = 0, binding = 1) buffer TmpBuffer { float tmp[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
} pc;

void main() {
    uint j = gl_GlobalInvocationID.x;
    uint k = gl_GlobalInvocationID.y;
    
    if (j >= pc.cols || k >= pc.cols) return;
    
    float sum = 0.0;
    for (uint i = 0; i < pc.rows; i++) {
        sum += x[i * pc.cols + j] * x[i * pc.cols + k];
    }
    
    tmp[j * pc.cols + k] = sum;
}
